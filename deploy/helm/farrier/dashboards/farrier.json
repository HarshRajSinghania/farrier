{
  "title": "Farrier",
  "uid": "farrier",
  "tags": [
    "farrier",
    "certificates"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Expiring in 7 days, no renewal",
      "description": "Certificates close to expiry with no open renewal: run `farrier explain <endpoint>`.",
      "targets": [
        {
          "refId": "A",
          "expr": "count((farrier_cert_expires_in_seconds < 7 * 86400) unless on(endpoint) farrier_renewal_planned_timestamp_seconds) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Expired",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(farrier_cert_expired) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Endpoints down",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "count(farrier_endpoint_up == 0) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Approvals pending",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(farrier_approvals_pending) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Runner groups offline",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "count(farrier_runner_group_online == 0) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Audit log",
      "targets": [
        {
          "refId": "A",
          "expr": "farrier_audit_log_intact",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "BROKEN",
                  "color": "red"
                },
                "1": {
                  "text": "intact",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Renewals by state",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (farrier_renewals)",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Endpoints failing renewal, by reason",
      "description": "Every reason code has a fix in the troubleshooting guide.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason, issuer) (farrier_endpoints_failing)",
          "legendFormat": "{{reason}} ({{issuer}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Soonest expiring (days left)",
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(25, farrier_cert_expires_in_seconds / 86400)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "container": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Next planned renewals",
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(25, farrier_renewal_planned_timestamp_seconds * 1000)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "container": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Runner groups: pending jobs",
      "targets": [
        {
          "refId": "A",
          "expr": "farrier_runner_group_pending_jobs",
          "legendFormat": "{{group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Approvals pending",
      "targets": [
        {
          "refId": "A",
          "expr": "farrier_approvals_pending",
          "legendFormat": "overdue={{overdue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 12
    }
  ]
}
