# Runtime secrets. Two kinds:
#
# * Generated here (API tokens, session secret or dashboard password). Their values are in the
#   Terraform state, so keep state in an encrypted, access-controlled backend (S3 + KMS).
# * Seeded by you (the KMS-wrapped master key, the OIDC client secret). Terraform creates the empty
#   secret only, so these values never touch the state. See README "Seed the secrets".

resource "random_password" "api_token" {
  length  = 48
  special = false
}

resource "random_password" "api_read_token" {
  length  = 48
  special = false
}

resource "random_password" "session_secret" {
  count = local.oidc_enabled ? 1 : 0

  length  = 64
  special = false
}

resource "random_password" "dashboard_password" {
  count = local.oidc_enabled ? 0 : 1

  length  = 32
  special = false
}

locals {
  generated_secret_names = concat(
    ["api-token", "api-read-token"],
    local.oidc_enabled ? ["session-secret"] : ["dashboard-password"],
  )
  generated_secret_values = {
    "api-token"          = random_password.api_token.result
    "api-read-token"     = random_password.api_read_token.result
    "session-secret"     = local.oidc_enabled ? random_password.session_secret[0].result : ""
    "dashboard-password" = local.oidc_enabled ? "" : random_password.dashboard_password[0].result
  }

  seeded_secret_names = concat(["master-key"], local.oidc_enabled ? ["oidc-client-secret"] : [])
}

resource "aws_secretsmanager_secret" "generated" {
  for_each = toset(local.generated_secret_names)

  name                    = "${local.runtime_prefix}${each.key}"
  description             = "Farrier ${each.key} (generated by Terraform)"
  kms_key_id              = aws_kms_key.app.arn
  recovery_window_in_days = var.secret_recovery_window_days
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "generated" {
  for_each = toset(local.generated_secret_names)

  secret_id     = aws_secretsmanager_secret.generated[each.key].id
  secret_string = local.generated_secret_values[each.key]
}

resource "aws_secretsmanager_secret" "seeded" {
  for_each = toset(local.seeded_secret_names)

  name                    = "${local.runtime_prefix}${each.key}"
  description             = "Farrier ${each.key} (seeded out of band; never in Terraform state)"
  kms_key_id              = aws_kms_key.app.arn
  recovery_window_in_days = var.secret_recovery_window_days
  tags                    = local.tags
}

locals {
  secret_arns = merge(
    { for k, s in aws_secretsmanager_secret.generated : k => s.arn },
    { for k, s in aws_secretsmanager_secret.seeded : k => s.arn },
  )

  db_secret_arn = aws_db_instance.this.master_user_secret[0].secret_arn

  engine_secret_arns = [
    local.secret_arns["api-token"],
    local.secret_arns["api-read-token"],
    local.secret_arns["master-key"],
    local.db_secret_arn,
  ]

  web_secret_arns = concat(
    [local.secret_arns["api-token"], local.secret_arns["api-read-token"]],
    local.oidc_enabled ? [local.secret_arns["session-secret"], local.secret_arns["oidc-client-secret"]] : [local.secret_arns["dashboard-password"]],
  )
}
