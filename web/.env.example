# Copy to .env.local. Every variable is optional; with none set the dashboard runs in demo mode.

# Farrier API the dashboard talks to (server-side only, never sent to the browser).
FARRIER_API_URL=http://127.0.0.1:8740
# Must match FARRIER_API_TOKEN on the Farrier server, if it has one (admin: read and change).
FARRIER_API_TOKEN=
# Optional read-only engine token. SSO viewers reach the engine with it, so the engine refuses
# their changes too. Must match FARRIER_API_READ_TOKEN on the Farrier server.
FARRIER_API_READ_TOKEN=

# Sign-in. In production with FARRIER_API_URL set, configure single sign-on or Basic auth.

# --- Single sign-on (OpenID Connect). Setting FARRIER_OIDC_ISSUER turns it on; Basic auth is then ignored.
# Register a confidential web app with redirect URI https://<dashboard host>/auth/callback
# and sign-out redirect URI https://<dashboard host>/auth/signin?signed_out=1.
FARRIER_OIDC_ISSUER=
FARRIER_OIDC_CLIENT_ID=
FARRIER_OIDC_CLIENT_SECRET=
# Google and Entra ID reject the "groups" scope: use "openid profile email" with them.
FARRIER_OIDC_SCOPES=openid profile email groups
# 32+ random bytes that encrypt the session cookie: openssl rand -base64 48
FARRIER_SESSION_SECRET=
# Claim holding groups or roles. Dotted paths work (Keycloak realm roles: realm_access.roles);
# Entra app roles: roles.
FARRIER_OIDC_ROLE_CLAIM=groups
# Comma-separated group names (or ids, for Entra). Anyone else who signs in is a viewer.
FARRIER_OIDC_ADMIN_GROUPS=
FARRIER_OIDC_OPERATOR_GROUPS=
# If set, people in none of these groups (nor the admin/operator groups) are refused.
FARRIER_OIDC_ALLOWED_GROUPS=
# Pin these behind a reverse proxy that rewrites Host (default: derived from the request).
FARRIER_OIDC_REDIRECT_URI=
FARRIER_OIDC_POST_LOGOUT_REDIRECT_URI=
# Session timeouts: idle minutes (default 60) and absolute hours since sign-in (default 12).
FARRIER_SESSION_IDLE_MINUTES=60
FARRIER_SESSION_MAX_HOURS=12

# --- Fallback when SSO is off: HTTP Basic auth for /dashboard and /api/farrier (one shared admin login).
FARRIER_DASHBOARD_USER=admin
FARRIER_DASHBOARD_PASSWORD=

# Public URL of this dashboard (sign-in origin checks; https:// turns on HSTS).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Documentation links go (read at runtime). Default: the public docs, else the docs' source on GitHub.
FARRIER_DOCS_URL=
